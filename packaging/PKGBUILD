# Generated source archive/checksum is supplied by scripts/build-package.sh.
pkgname=flufflinux-appcenter
pkgver=2026.9.0beta
pkgrel=1
pkgdesc='Native Flatpak App Center for Fluff Linux'
arch=('x86_64')
url='https://github.com/FluffNet/flufflinux-appcenter'
license=('MIT')
PACKAGER='FluffNet LLC'
depends=('glibc' 'libgcc' 'libstdc++' 'glib2' 'qt6-base' 'qt6-declarative'
         'qt6-svg' 'qt6-wayland' 'flatpak' 'ostree' 'polkit' 'gzip'
         'kirigami' 'qqc2-desktop-style' 'breeze-icons' 'plasma-integration'
         'xdg-desktop-portal' 'xdg-desktop-portal-kde' 'xdg-utils'
         'desktop-file-utils' 'gtk-update-icon-cache' 'hicolor-icon-theme'
         'flufflinux-update')
makedepends=('rust' 'pkgconf')
conflicts=('discover' 'flufflinux-discover')
replaces=('discover' 'flufflinux-discover')
backup=('etc/flufflinux-appcenter/exclusions.conf')
install=flufflinux-appcenter.install
options=('!debug')
source=("$pkgname-$pkgver.tar.gz")
sha256sums=('@SOURCE_SHA256@')

build() {
    cd "$srcdir/$pkgname"
    make build
}

check() {
    cd "$srcdir/$pkgname"
    cargo test --release
}

package() {
    cd "$srcdir/$pkgname"
    make install DESTDIR="$pkgdir" PREFIX=/usr SYSCONFDIR=/etc \
        REGISTER_MIME=0 EXCLUSIONS_FILE=data/exclusions.conf
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
